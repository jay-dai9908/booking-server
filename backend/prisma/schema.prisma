generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  line_user_id      String         @unique
  name              String?
  phone             String?
  line_display_name String?
  line_picture_url  String?
  line_status_msg   String?
  last_login_at     DateTime?
  created_at        DateTime       @default(now())
  is_blacklisted    Boolean        @default(false)
  notes             String?
  
  reservations      Reservation[]
  login_logs        UserLoginLog[]
  product_orders    ProductOrder[]
  user_passes       UserPass[]
}

model UserLoginLog {
  id           Int      @id @default(autoincrement())
  user_id      Int
  ip_address   String?
  os           String?
  device_model String?
  browser      String?
  line_version String?
  screen_info  String?
  language     String?
  user_agent   String?
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([created_at])
}

model Session {
  id           Int           @id @default(autoincrement())
  session_date DateTime      @db.Date
  start_time   String        // 例如: "10:00"
  end_time     String        // 例如: "11:00"
  max_capacity Int
  
  reservations Reservation[]

  @@unique([session_date, start_time])
}

model Reservation {
  id             Int      @id @default(autoincrement())
  booking_ref    String   @default(uuid())
  session_id     Int
  user_id        Int
  pax            Int
  status         String   @default("confirmed")
  created_at     DateTime @default(now())
  attendance     String?
  checked_in_at  DateTime?
  assigned_seats String[] // e.g. ["A1-1", "A1-2"]
  is_seat_locked Boolean  @default(false)
  is_force_split Boolean  @default(false)
  is_unlimited   Boolean  @default(false)
  is_walk_in     Boolean  @default(false)
  is_paid        Boolean  @default(false)
  total_amount   Int?
  is_amount_manual Boolean @default(false)
  paid_at        DateTime?
  payment_method String?
  checkout_unlimited_pax Int?
  checkout_regular_hours Float?
  checkout_details Json?
  promo_code     String?
  discount_amount Int?    @default(0)
  addons_amount  Int?     @default(0)
  customer_note  String?
  admin_note     String?
  cancelled_at   DateTime?
  cancelled_by   String?
  
  checked_in_by    String?   // 報到的店員名字
  seat_source      String?   // auto | staff | customer（staff = 店員帶位，排位時固定不動）
  billing_status   String?   // unpaid | partial | paid | waived（4.6 算出來的快取）
  has_refund       Boolean   @default(false)
  paid_persons     Int       @default(0)
  amount_due       Int?      // 目前應收總額（帳單重算結果）
  amount_received  Int       @default(0)       // 有效收款 + 補收 − 退款（不含卡券折抵）
  
  session        Session  @relation(fields: [session_id], references: [id])
  user           User     @relation(fields: [user_id], references: [id])
}

model DailySetting {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique @db.Date
  allow_unlimited Boolean  @default(true)
  hourly_price    Int?
  unlimited_price Int?
}

model GlobalSetting {
  id                          Int      @id @default(1)
  weekday_hourly_price        Int      @default(100)
  weekday_unlimited_price     Int      @default(550)
  weekend_hourly_price        Int      @default(150)
  weekend_unlimited_price     Int      @default(800)
  is_lockdown_mode            Boolean  @default(false)
  allow_equipment_exceed_pax  Boolean  @default(false)
  show_equipment_live_stock   Boolean  @default(true)
  equipment_discount_enabled  Boolean  @default(true)
  equipment_discount_buy_hours Int     @default(3)
  equipment_discount_free_hours Int    @default(1)
  equipment_discount_stackable Boolean @default(true)
  equipment_discount2_enabled Boolean  @default(false)
  equipment_discount2_buy_hours Int    @default(8)
  equipment_discount2_free_hours Int   @default(4)
  show_price_cards            Boolean  @default(true)
  price_notice_text           String?  @default("費用皆含基礎傳統拼豆板與豆子無限使用．預約現場保留 15 分鐘．離場前請預留 10 分鐘壓平作品")
  show_announcement           Boolean  @default(true)
  announcement_text           String?  @default("✨ 歡迎來到拾光製所！線上預約享即時選位，智能拼豆板租借滿時數再享買送折抵優惠")
  show_line_button            Boolean  @default(true)
  line_button_url             String?  @default("https://lin.ee/vsZhRW5")
  require_line_login_every_time Boolean @default(false)
  enable_preview_page         Boolean  @default(true)
  preview_disabled_text       String?  @default("系統維護中，請點擊下方按鈕使用 LINE 進行預約")
  line_messaging_token        String?
  line_auto_notify_booking    Boolean  @default(false)
  line_auto_notify_cancel     Boolean  @default(false)
  shop_enabled                Boolean  @default(true)
  show_shop_button            Boolean  @default(true)
  shop_deposit_deadline_days  Int      @default(2)
  shop_default_arrival_note   String?  @default("預計 11/10 ~ 11/15 到貨，商品抵達門市後將發送 LINE 訊息通知取貨")
  shop_enable_shipping        Boolean  @default(false)
  shop_shipping_fee           Int      @default(60)
  official_line_url           String?  @default("https://lin.ee/vsZhRW5")
  bead_colors_json            Json?
  business_hours_json         Json?

  // 計時與收費
  billing_grace_minutes         Int      @default(10)
  billing_block_minutes         Int      @default(30)
  early_leave_mode              String   @default("booked")  // booked 照預約時數 | actual 照實際
  board_swap_grace_minutes      Int      @default(10)
  // 收款
  payment_methods_json          Json?    // [{code:"cash",label:"現金",enabled:true}, ...]
  default_split_mode            String   @default("proportional") // proportional | even | first
  cash_float_amount             Int      @default(2000)  // 零用金
  // 列印
  print_enabled                 Boolean  @default(true)  // 啟用列印總開關
  auto_print_receipt            Boolean  @default(true)  // 完成結帳就列印
  auto_print_summary            Boolean  @default(true)  // 整組結清時自動印整單總表
  receipt_footer_text           String?  @default("謝謝光臨，作品記得帶回家")
  print_lease_seconds           Int      @default(60)
  seat_layout_enabled           Boolean  @default(false)
  default_session_capacity      Int      @default(16)
  // 快速選項與訪客提示 (Round 9)
  booking_note_chips            Json?    @default("[\"第一次玩\", \"有小孩同行\", \"生日慶祝\", \"希望坐一起\"]")
  guest_line_hint_text          String?  @default("會打開拾光製所的官方 LINE，從選單點『預約』就能登入")
}

model BannedIP {
  id         Int      @id @default(autoincrement())
  ip         String   @unique
  reason     String?
  banned_at  DateTime @default(now())
}

model AdminUser {
  id            Int      @id @default(autoincrement())
  name          String
  password      String   @unique
  role          String   @default("staff")
  permissions   String[] @default([])
  is_active     Boolean  @default(true)
  token_version Int      @default(0)
  created_at    DateTime @default(now())
}

model EquipmentConfig {
  id                   String             @id
  name                 String
  visibility_status    String             @default("ACTIVE") // ACTIVE, MAINTENANCE, HIDDEN
  status_note          String?
  total_stock          Int?
  hourly_rate          Int
  daily_cap            Int?
  min_contiguous_hours Int                @default(2)
  allow_exceed_pax     Boolean            @default(false)
  sort_order           Int                @default(0)
  created_at           DateTime           @default(now())

  booking_equipments   BookingEquipment[]
}

model BookingEquipment {
  id                      Int             @id @default(autoincrement())
  booking_ref             String
  equipment_id            String
  equipment_name_snapshot String
  quantity                Int             @default(1)
  rental_hours            Int             @default(2)
  subtotal_price          Int             @default(0)
  covered_sessions        String[]        @default([])
  created_at              DateTime        @default(now())

  person_id        Int?       // 給哪一位（BookingPerson.id）
  unit_group       String?    // 同一台板子的每一段共用一個 uuid
  segment_no       Int        @default(1)
  start_at         DateTime?  // 這一段開始（null = 依 covered_sessions 推算）
  end_at           DateTime?  // 這一段結束
  unit_rate        Int?       // 這一段的單價快照（元／小時）
  ended_reason     String?    // swapped | returned | null
  planned_end_at   DateTime?  // 原本預約的結束時間（拆列或第一次換板時填入），提早歸還時照這個計費（4.4.3）

  equipment               EquipmentConfig @relation(fields: [equipment_id], references: [id])

  @@index([booking_ref])
  @@index([unit_group])
}

model BoardPause {
  id          Int       @id @default(autoincrement())
  unit_group  String
  started_at  DateTime
  ended_at    DateTime?
  source      String    // person | solo
  staff_name  String?

  @@index([unit_group])
}

model PromoCode {
  id                  Int       @id @default(autoincrement())
  code                String    @unique
  name                String
  description         String?
  discount_type       String    @default("fixed_order") // "fixed_order", "fixed_per_pax", "percentage", "free_hours"
  discount_value      Int       @default(0)
  max_discount_amount Int?
  target_scope        String    @default("all") // "all", "seating", "equipment"
  day_type_limit      String    @default("all") // "all", "weekday", "weekend"
  mode_limit          String    @default("all") // "all", "hourly", "unlimited"
  channel             String    @default("all") // "all" 線上+櫃檯, "online" 僅線上預約, "pos" 僅限櫃檯
  min_pax             Int       @default(1)
  min_hours           Int       @default(1)
  min_amount          Int       @default(0)
  max_uses            Int?
  max_uses_per_user   Int?
  used_count          Int       @default(0)
  is_pos_quick_select Boolean   @default(false)
  is_active           Boolean   @default(true)
  start_date          DateTime? @db.Date
  end_date            DateTime? @db.Date
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
}

model AddonItem {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  category    String   @default("charm") // "charm", "service", "other"
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
}

model PaymentMethodConfig {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique
  name                 String
  method_type          String   // "POOL_ACCOUNT", "MULTI_BANK", "EWALLET", "ONSITE"
  is_enabled           Boolean  @default(true)
  display_instructions String?
  bank_accounts_json   Json?
  require_last5        Boolean  @default(true)
  show_line_verify_btn Boolean  @default(true)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt
}

model OneTimeAccountPool {
  id                  Int       @id @default(autoincrement())
  payment_method_code String    @default("ctbc_pool")
  bank_code           String    @default("822")
  bank_name           String    @default("中國信託（社群收款專屬帳號）")
  account_number      String    @unique
  payment_url         String?
  note                String?
  status              String    @default("AVAILABLE") // "AVAILABLE", "ASSIGNED", "USED", "VOID"
  assigned_order_ref  String?
  assigned_user_id    Int?
  assigned_at         DateTime?
  verified_at         DateTime?
  created_at          DateTime  @default(now())
}

model Product {
  id                     Int       @id @default(autoincrement())
  code                   String    @unique
  name                   String
  category               String    @default("bundle") // "bundle", "beads", "tools", "boards", "cloth"
  description            String?
  image_url              String?
  images_json            Json?
  price                  Int
  is_preorder            Boolean   @default(true)
  deposit_amount         Int       @default(600)
  estimated_arrival_text String?
  allow_wish_input       Boolean   @default(false)
  wish_input_placeholder String?   @default("可輸入喜歡的顏色、款式或 IP 角色（例如：吉伊卡哇、馬卡龍粉、雙針筆優先）")
  bonus_pass_plan_code   String?
  tier_pricing           Json?
  tier_discount_mode     String    @default("combined") // "combined" (混色合計包數) or "per_color" (單色獨立計算)
  visibility_status      String    @default("ACTIVE") // "ACTIVE", "SOLD_OUT", "HIDDEN"
  sort_order             Int       @default(0)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now()) @updatedAt

  items                  ProductOrderItem[]
}

model ProductOrder {
  id                     Int       @id @default(autoincrement())
  order_ref              String    @unique // PO-YYYYMMDD-XXXX
  user_id                Int
  total_amount           Int
  shipping_fee           Int       @default(0)
  deposit_required       Int
  paid_amount            Int       @default(0)
  balance_amount         Int
  payment_method_code    String
  selected_bank_info     String?
  assigned_pool_account  String?
  assigned_pool_url      String?
  remittance_last5       String?
  remittance_reported_at DateTime?
  payment_deadline       DateTime?
  payment_status         String    @default("pending_payment") // "pending_payment", "reported_pending_verify", "deposit_verified", "fully_paid", "refunded"
  order_status           String    @default("preorder_placed") // "preorder_placed", "preparing", "arrived", "picked_up", "cancelled"
  delivery_method        String    @default("store_pickup") // "store_pickup", "shipping"
  shipping_info_json     Json?
  estimated_arrival      String?
  wish_note              String?
  wish_reply             String?
  customer_note          String?
  admin_note             String?
  arrived_notified_at    DateTime?
  picked_up_at           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now()) @updatedAt

  items                  ProductOrderItem[]
  user                   User      @relation(fields: [user_id], references: [id])
}

model ProductOrderItem {
  id                     Int          @id @default(autoincrement())
  order_id               Int
  product_id             Int?
  product_code_snapshot  String
  product_name_snapshot  String
  price_snapshot         Int
  quantity               Int
  subtotal               Int
  customization_note     String?

  order                  ProductOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                Product?     @relation(fields: [product_id], references: [id])
}

model PassPlan {
  id                     Int       @id @default(autoincrement())
  code                   String    @unique
  name                   String
  pass_type              String    // "PUNCH_CARD", "DISCOUNT_VOUCHER", "MONTHLY_PASS", "TIME_PASS"
  price                  Int       @default(0)
  is_purchasable_online  Boolean   @default(false)
  total_quota            Int?
  valid_days             Int?
  day_restriction        String    @default("ALL") // "ALL", "WEEKDAY_ONLY", "WEEKEND_ONLY"
  max_hours_per_day      Int?
  max_days_per_week      Int?
  max_hours_per_week     Int?
  discount_percent       Int?
  description            String?
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())

  checkout_effect   String?   // entry_hours | entry_full | percent_off | fixed_amount；null = 依 pass_type 預設
  checkout_scope    String    @default("entry")  // entry 只折入場 | all 入場＋智能板＋加購
  checkout_value    Int?      // fixed_amount 用：每次折多少元

  user_passes            UserPass[]
}

model UserPass {
  id                     Int       @id @default(autoincrement())
  pass_code              String    @unique // PASS-88392014
  user_id                Int
  plan_id                Int
  plan_name_snapshot     String
  pass_type              String
  remaining_quota        Int?
  total_quota            Int?
  day_restriction        String    @default("ALL")
  max_hours_per_day      Int?
  max_days_per_week      Int?
  max_hours_per_week     Int?
  usage_logs_json        Json?
  payment_status         String    @default("active") // "active", "pending_payment"
  order_ref              String?
  expires_at             DateTime?
  status                 String    @default("ACTIVE") // "ACTIVE", "EXHAUSTED", "EXPIRED", "REVOKED"
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now()) @updatedAt

  user                   User      @relation(fields: [user_id], references: [id])
  plan                   PassPlan  @relation(fields: [plan_id], references: [id])
}

// -------------------------------------------------------------
// 座位版面（Section 3.1）
// -------------------------------------------------------------

model SeatLayout {
  id                  Int        @id @default(autoincrement())
  name                String     @default("店內格局")
  status              String     @default("draft")   // draft | published | archived
  effective_from      DateTime?  @db.Date            // 發布時填入；某天用「effective_from <= 那天」中最新的一份
  canvas_w            Int        @default(1000)      // 平面圖單位：1 單位 = 1 公分
  canvas_h            Int        @default(625)
  seat_tile_w         Int        @default(60)        // 座位格在平面圖上的寬高（平面圖單位）
  seat_tile_h         Int        @default(46)
  grid_size           Int        @default(10)
  background_image    String?    @db.Text            // data URL
  background_opacity  Float      @default(0.35)
  background_rect     Json?      // { x, y, w, h, rotation }
  elements_json       Json       @default("[]")      // 牆面、門口、櫃檯、柱子、窗戶
  rules_json          Json       @default("{}")      // 排位規則
  capacity            Int        @default(0)         // 發布時算好：可自動排的啟用座位數
  created_by_name     String?
  published_by_name   String?
  published_at        DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @default(now()) @updatedAt

  zones               SeatZone[]
  tables              SeatTable[]
  seats               Seat[]

  @@index([status, effective_from])
}

model SeatZone {
  id          Int        @id @default(autoincrement())
  layout_id   Int
  name        String                 // 前區、後區
  note        String?                // 靠門口
  sort_order  Int        @default(0) // 排位順序，越小越先排
  polygon     Json?                  // [[x,y],...] 平面圖上的區域範圍
  layout      SeatLayout @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  tables      SeatTable[]
  seats       Seat[]
}

model SeatTable {
  id               Int        @id @default(autoincrement())
  layout_id        Int
  zone_id          Int
  label            String                 // 桌 1、長桌
  shape            String     @default("rect")      // rect | square | round | long
  arrangement      String     @default("two_sides") // two_sides | one_side | around | free
  cx               Float                  // 桌子中心（平面圖單位）
  cy               Float
  w                Float      @default(60)   // 桌面寬、長（公分）
  h                Float      @default(150)
  rotation         Float      @default(0)    // 度，順時針，-180～180
  sort_order       Int        @default(0)    // 同區內的桌號順序（左右交錯依此）
  layout           SeatLayout @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  zone             SeatZone   @relation(fields: [zone_id], references: [id])
  seats            Seat[]
}

model Seat {
  id              Int        @id @default(autoincrement())
  layout_id       Int
  table_id        Int?                    // 單獨擺的座位為 null
  zone_id         Int                     // 有桌子時必須等於桌子的 zone_id
  code            String                  // 1-1、L-3、A1-1
  lx              Float                   // 相對桌子中心座標或絕對座標
  ly              Float
  side_mode       String     @default("auto")   // auto | manual
  side            String?                 // L | R | null
  tags            String[]   @default([])  // vent | window | outlet | kids
  priority        String     @default("normal") // normal | second | last | manual_only
  is_active       Boolean    @default(true)     // false = 暫停使用
  adjacent_codes  String[]   @default([])  // 手動指定相鄰座位
  opposite_codes  String[]   @default([])  // 手動指定對面
  sort_order      Int        @default(0)    // 順序
  origin_code     String?                 // 複製草稿時原本代號
  layout          SeatLayout @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  table           SeatTable? @relation(fields: [table_id], references: [id])
  zone            SeatZone   @relation(fields: [zone_id], references: [id])

  @@unique([layout_id, code])
}

// -------------------------------------------------------------
// 現場每位客人與計時（Section 3.2）
// -------------------------------------------------------------

model BookingPerson {
  id                Int       @id @default(autoincrement())
  booking_ref       String
  person_no         Int                     // 第幾位，從 1 開始
  seat_code         String?                 // 實際座位
  status            String    @default("active")   // active | removed
  is_onsite_added   Boolean   @default(false)      // 現場加人
  billing_start_at  DateTime?                       // 計費起點
  timer_started_at  DateTime?                       // 開始計時
  timer_ended_at    DateTime?                       // 離場或結帳時結束
  paused_at         DateTime?                       // 正在暫停時間
  paused_seconds    Int       @default(0)           // 已結束的暫停加總
  created_by_name   String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  pauses            TimerPause[]

  @@unique([booking_ref, person_no])
  @@index([booking_ref])
}

model TimerPause {
  id            Int           @id @default(autoincrement())
  person_id     Int
  started_at    DateTime
  ended_at      DateTime?
  reason        String?       // 外出用餐 | 休息 | 其他
  staff_name    String?
  person        BookingPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 收款紀錄（Section 3.4）
// -------------------------------------------------------------

model Payment {
  id                  Int       @id @default(autoincrement())
  payment_no          String    @unique          // R-0001
  batch_no            String
  client_batch_id     String?
  booking_ref         String
  kind                String                     // charge | supplement | refund | waive
  status              String    @default("valid") // valid | voided
  method              String                     // cash | line_pay | jkopay | card | transfer | pass | other | none
  amount              Int                        // 正數
  waived_amount       Int?
  cash_received       Int?
  change_given        Int?
  person_nos          Int[]
  breakdown_json      Json
  pass_json           Json?
  related_payment_id  Int?
  reason              String?
  note                String?
  staff_name          String
  staff_id            Int?
  device_id           String?
  device_label        String
  receipt_status      String    @default("none") // none | queued | printed | failed | local
  created_at          DateTime  @default(now())
  voided_at           DateTime?
  voided_by_name      String?
  void_reason         String?

  @@index([booking_ref])
  @@index([created_at])
  @@index([batch_no])
  @@index([client_batch_id])
}

// -------------------------------------------------------------
// 異動紀錄（Section 3.5）
// -------------------------------------------------------------

model AccountingEvent {
  id            Int       @id @default(autoincrement())
  booking_ref   String?
  event_type    String
  category      String    // payment | void | refund | amount | print | pass | closing | status
  summary       String
  amount        Int?
  before_json   Json?
  after_json    Json?
  reason        String?
  payment_id    Int?
  print_job_id  Int?
  staff_name    String
  staff_id      Int?
  device_id     String?
  device_label  String
  created_at    DateTime  @default(now())

  @@index([created_at])
  @@index([booking_ref])
  @@index([category, created_at])
}

// -------------------------------------------------------------
// 列印（Section 3.6）
// -------------------------------------------------------------

model PrintStation {
  id               Int       @id @default(autoincrement())
  name             String    @default("櫃檯商米")
  secret_hash      String
  is_active        Boolean   @default(true)
  is_default       Boolean   @default(true)
  accepting        Boolean   @default(true)
  last_seen_at     DateTime?
  printer_state    String?   // ok | no_paper | overheat | cover_open | error | not_found
  printer_message  String?
  app_version      String?
  device_model     String?
  paired_by_name   String?
  created_at       DateTime  @default(now())
}

model PrintJob {
  id                Int       @id @default(autoincrement())
  job_no            String    @unique         // P-0413
  station_id        Int?
  type              String                    // receipt | supplement | refund | summary | closing | test
  booking_ref       String?
  payment_id        Int?
  batch_no          String?
  closing_id        Int?
  title             String
  commands_json     Json
  is_reprint        Boolean   @default(false)
  reprint_of_id     Int?
  copy_no           Int       @default(1)
  status            String    @default("queued") // queued | claimed | printed | failed | cancelled
  error_code        String?
  error_message     String?
  attempts          Int       @default(0)
  claimed_at        DateTime?
  lease_until       DateTime?
  printed_at        DateTime?
  printed_by        String?
  requested_by_name String
  requested_device  String
  created_at        DateTime  @default(now())

  @@index([status, created_at])
  @@index([booking_ref])
}

// -------------------------------------------------------------
// 交班與流水號（Section 3.7）
// -------------------------------------------------------------

model CashClosing {
  id               Int       @id @default(autoincrement())
  business_date    DateTime  @db.Date
  float_amount     Int
  expected_cash    Int
  counted_cash     Int
  difference       Int
  totals_json      Json
  note             String?
  staff_name       String
  device_label     String
  created_at       DateTime  @default(now())
}

model DailyCounter {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  key         String   // payment | job
  value       Int      @default(0)
  @@unique([date, key])
}



